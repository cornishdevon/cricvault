modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 23131
externalPort = 80

[[ports]]
localPort = 25973
externalPort = 3000

[userenv]

[userenv.shared]
OWNER_EMAIL = "ncarterj@yahoo.co.uk"
DATA_IMPORT_TOKEN = "bd3c3fd2134be0412ae8f26b567190074650d800b12e871f"
